# StreamMart Environment Variables Template
# Copy this file to .env and configure values before starting services

# Application Environment
NODE_ENV=development
PORT=8085
GATEWAY_URL=http://localhost:8085

# Database Configuration (PostgreSQL)
# For local Docker Compose Postgres:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/streammart
# For local host access:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streammart
# For remote/serverless Neon DB:
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Apache Kafka Configuration (KRaft Single-Node Broker)
# Within Docker Compose network:
KAFKA_BROKERS=kafka:9092
# From host machine:
# KAFKA_BROKERS=localhost:9094

# Authentication (API Gateway JWT Secret)
JWT_SECRET=streammart-super-secure-jwt-secret-key-32-bytes!

# Internal Service Routing (Used by API Gateway)
PAYMENT_SERVICE_URL=http://payment-service:8000
