{
  "name": "streammart",
  "version": "1.0.0",
  "description": "StreamMart: Enterprise Event-Driven E-Commerce Microservices",
  "type": "module",
  "scripts": {
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "stack:ps": "docker compose ps",
    "checkout:test": "node scripts/test-checkout.js",
    "demo:outage": "node scripts/demo-outage.js",
    "latency:test": "node scripts/measure-latency.js",
    "test:gateway": "npm test --prefix api-gateway",
    "test:payment": "npm test --prefix payment-service",
    "test:order": "npm test --prefix order-service",
    "test:email": "npm test --prefix email-service",
    "test:analytic": "npm test --prefix analytic-service",
    "test": "npm test --prefix api-gateway && npm test --prefix payment-service && npm test --prefix order-service && npm test --prefix email-service && npm test --prefix analytic-service",
    "db:migrate": "node payment-service/test-db.js"
  },
  "keywords": [
    "kafka",
    "microservices",
    "transactional-outbox",
    "postgresql",
    "drizzle-orm",
    "docker-compose"
  ],
  "author": "Vipin",
  "license": "ISC"
}

